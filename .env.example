# Flow Task Manager remote PostgreSQL example.
# Copy values into your shell profile or a local .env file that is not committed.

# Local PostgreSQL fallback
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowtaskmanager
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

