# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-123456.ap-northeast-1.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=replace-with-your-neon-password
